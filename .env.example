# Copy to .env.local and adjust. Vite only exposes VITE_ variables (plus the two Supabase
# public values mapped in vite.config.js) to the browser.

# Staff PINs (a deterrent, not real security: both end up in the JavaScript bundle).
# Ushers can open check-in; organizers can also open the dashboard.
VITE_USHER_PIN=2026
VITE_ORGANIZER_PIN=4826

# Optional: cross-device live sync. Leave empty to use localStorage (single browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only for `node scripts/apply-schema.mjs` (never sent to the browser).
POSTGRES_URL=
